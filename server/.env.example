MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=accessibility-analyzer
GEMINI_API_KEY=your_gemini_api_key
SECRET_KEY=generate_a_secure_random_string_at_least_32_characters_long
RESET_EMAIL_COOLDOWN_MINUTES=2
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-production-domain.com
CSRF_SECRET=generate_another_secure_random_string_for_csrf_protection
JWT_ISSUER=accessibility-analyzer
JWT_AUDIENCE=accessibility-analyzer-client
APP_ENV=production
ALLOW_DEMO_LOGIN=false
SEED_DEFAULT_USERS=false

# Demo / seed user credentials (only used when SEED_DEFAULT_USERS=true)
# MUST be overridden with strong values in production if seeding is enabled
DEMO_USER_EMAIL=test@example.com
DEMO_USER_PASSWORD=change_this_to_a_strong_password
DEMO_USER_NAME=Test User
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_PASSWORD=change_this_to_a_strong_password
ADMIN_USER_NAME=Admin User

# Trusted proxy IPs for correct client IP detection behind load balancers (comma-separated)
# TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2
TRUSTED_PROXY_IPS=

# X-Content-Type-Options header value (default: nosniff)
X_CONTENT_TYPE_OPTIONS=nosniff
